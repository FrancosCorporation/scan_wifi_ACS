# Credenciais OAuth2 da API Flashman (obrigatorias)
FLASHMAN_CLIENT_ID=seu_client_id
FLASHMAN_CLIENT_SECRET=seu_client_secret

# Gere um segredo diferente por instalação: openssl rand -base64 48
API_TOKEN=

# Bind local por padrão. Use 0.0.0.0 somente dentro de um container/rede protegida.
HOST=127.0.0.1
PORT=3000
# Opcional: IPs/sub-redes exatas dos proxies reversos confiáveis (não use "true").
TRUST_PROXY=

# Opcional: URL da API Flashman
FLASHMAN_API_BASE_URL=https://flashman.olvtelecom.com.br

# Opcional: arquivo PEM da CA privada da API Flashman (nunca desative validação TLS)
FLASHMAN_CA_FILE=

# URL do Ollama; no Docker, configure o endereço do host ou da rede do Ollama.
OLLAMA_URL=http://127.0.0.1:11434
